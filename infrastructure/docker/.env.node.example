NOVAVPN_ENV=dev
NOVAVPN_LISTEN_ADDR=:8080
NOVAVPN_REDIS_ADDR=redis:6379
# Замените заполнитель на пароль локальной базы из docker-compose.dev.yml.
NOVAVPN_DATABASE_URL=postgres://nova:REPLACE_WITH_DEV_DATABASE_PASSWORD@postgres:5432/novavpn?sslmode=disable
# Заполните секретом в base64: после декодирования не менее 32 случайных байт.
NOVAVPN_JWT_SECRET=
