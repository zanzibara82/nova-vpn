# По умолчанию закрыто всё; исключения открывают только входы сборки.
**
!go.mod
!go.sum
!internal
internal/**
!services
services/**
!migrations
migrations/**
!internal/**/*.go
!services/**/*.go
!migrations/*.go
!migrations/*.sql

# Даже исходники не берём из каталогов с секретами и посторонних деревьев.
**/.git
**/.git/**
**/.worktrees
**/.worktrees/**
**/.superpowers
**/.superpowers/**
**/.scratch
**/.scratch/**
**/node_modules
**/node_modules/**
**/secrets
**/secrets/**
**/etc_priv
**/etc_priv/**
**/.env*
**/.env*/**
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.wgkey
**/state.json
**/node_private_key
**/*.log
